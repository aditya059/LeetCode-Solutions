class Solution {
public:
    string smallestPalindrome(string s) {
        int n = s.length();
        int freq[26] = {0};
        for(int i = 0; i < n; i++) {
            freq[s[i] - 'a']++;
        }
        char middle = ' ';
        for(int i = 0; i < 26; i++) {
            if(freq[i] % 2 == 1) {
                freq[i] -= 1;
                middle = i + 'a';
            }
        }
        string ans = "";
        for(int i = 0; i < 26; i++) {
            if(freq[i]) {
                for(int j = 0; j < freq[i] / 2; j++) {
                    ans += i + 'a';
                }
            }
        }
        string rev = ans;
        reverse(rev.begin(), rev.end());
        if(middle != ' ')
            return ans + middle + rev;
        return ans + rev;
    }
};

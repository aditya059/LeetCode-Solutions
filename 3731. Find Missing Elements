class Solution {
public:
    vector<int> findMissingElements(vector<int>& nums) {
        sort(nums.begin(), nums.end());
        int j = nums[0];
        vector<int> ans;
        for(int i = 0; i < nums.size(); i++, j++) {
            while(j != nums[i]) {
                // cout << j << " " << nums[i] << endl;
                ans.push_back(j);
                j++;
            }
        }
        return ans;
    }
};

class Solution {
public:
    bool isGood(vector<int>& nums) {
        int n = *max_element(nums.begin(), nums.end());
        vector<int> freq(n + 1);
        for(int i = 0; i < nums.size(); i++) {
            freq[nums[i]]++;
        }
        for(int i = 1; i < n; i++) {
            if(freq[i] != 1) return false;
        }
        return freq[n] == 2;
    }
};

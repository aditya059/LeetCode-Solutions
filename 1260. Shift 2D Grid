class Solution {
public:
    vector<vector<int>> shiftGrid(vector<vector<int>>& grid, int k) {
        int m = grid.size(), n = grid[0].size();
        int total = m * n;
        k %= total;
        if(k == 0) return grid;
        vector<int> temp(total);
        for(int i = 0; i < m; i++) {
            for(int j = 0; j < n; j++) {
                temp[(i * n + j + k) % total] = grid[i][j];
            }
        }
        for(int i = 0; i < m; i++) {
            for(int j = 0; j < n; j++) {
                grid[i][j] = temp[i * n + j];
            }
        }
        return grid;
    }
};

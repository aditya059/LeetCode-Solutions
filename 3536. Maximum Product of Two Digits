class Solution {
public:
    int maxProduct(int n) {
        int highest = 0, secondHighest = 0;
        for(int i = n; i > 0; i /= 10) {
            int d = i % 10;
            if(d >= highest) {
                secondHighest = highest;
                highest = d;
            } else if(d >= secondHighest) {
                secondHighest = d;
            }
        }
        return highest * secondHighest;
    }
};

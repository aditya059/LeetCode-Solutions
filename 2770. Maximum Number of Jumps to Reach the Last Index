class Solution {
public:
    int maximumJumps(vector<int>& nums, int target) {
        int n = nums.size();
        vector<int> DP(n, INT_MIN);
        DP[0] = 0;
        for(int j = 1; j < n; j++) {
            for(int i = 0; i < j; i++) {
                int diff = nums[j] - nums[i];
                if(diff >= -target && diff <= target) {
                    DP[j] = max(DP[j], DP[i] + 1);
                }
            }
        }
        return max(-1, DP[n - 1]);
    }
};

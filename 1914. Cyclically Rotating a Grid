class Solution {
public:
    vector<vector<int>> rotateGrid(vector<vector<int>>& grid, int k) {
        int m = grid.size(), n = grid[0].size();
        for(int i = 0; i < min(m / 2, n / 2); i++) {
            vector<int> temp;
            for(int j = i; j < n - i; j++) {
                temp.push_back(grid[i][j]);
            }
            for(int j = i + 1; j < m - i; j++) {
                temp.push_back(grid[j][n - i - 1]);
            }
            for(int j = n - i - 2; j >= i; j--) {
                temp.push_back(grid[m - i - 1][j]);
            }
            for(int j = m - i - 2; j > i; j--) {
                temp.push_back(grid[j][i]);
            }

            // Rotate
            int sz = temp.size();
            int l = k % sz;
            vector<int> temp1(sz);
            for(int j = 0; j < sz; j++) {
                temp1[(j - l + sz) % sz] = temp[j];
            }

            // Fill back
            int p = 0;
            for(int j = i; j < n - i; j++) {
                grid[i][j] = temp1[p++];
            }
            for(int j = i + 1; j < m - i; j++) {
                grid[j][n - i - 1] = temp1[p++];
            }
            for(int j = n - i - 2; j >= i; j--) {
                grid[m - i - 1][j] = temp1[p++];
            }
            for(int j = m - i - 2; j > i; j--) {
                grid[j][i] = temp1[p++];
            }
        }
        return grid;
    }
};

class Solution {
public:
    string processStr(string s) {
        string ans = "";
        for(char &ch: s) {
            if(ch >= 'a' && ch <= 'z') {
                ans += ch;
            } else if(ch == '*' && ans.size() > 0) {
                ans.erase(ans.length() - 1);
            } else if(ch == '#') {
                ans += ans;
            } else {
                reverse(ans.begin(), ans.end());
            }
        }
        return ans;
    }
};

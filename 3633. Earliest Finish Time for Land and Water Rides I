class Solution {
public:
    int earliestFinishTime(vector<int>& landStartTime, vector<int>& landDuration, vector<int>& waterStartTime, vector<int>& waterDuration) {
        int m = landStartTime.size(), n = waterStartTime.size(), ans = INT_MAX;
        for(int i = 0; i < m; i++) {
            for(int j = 0; j < n; j++) {
                int x = landStartTime[i] + landDuration[i];
                int y = waterStartTime[j] + waterDuration[j];
                ans = min(ans, max(x, waterStartTime[j]) + waterDuration[j]);
                ans = min(ans, max(y, landStartTime[i]) + landDuration[i]);
            }
        }
        return ans;
    }
};
